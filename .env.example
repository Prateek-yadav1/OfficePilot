# Langfuse tracing is disabled unless explicitly enabled.
LANGFUSE_ENABLED=false

# Fill these only in your private .env file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Replace with your Langfuse project's region or self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Basic Authentication protects the UI and all non-health APIs.
# Replace the placeholder password with a unique secret (at least 16 characters).
OFFICEPILOT_AUTH_USERS={"demo":{"password":"replace-with-a-unique-secret","user_id":"officepilot-local-demo","tenant_id":"local-demo"}}

# Internal A2A requests require this shared secret (minimum 32 characters).
# Generate a random secret and keep it outside source control.
OFFICEPILOT_A2A_SHARED_SECRET=replace-with-a-random-32-character-secret

# The mock fixtures belong only to the local-demo user and tenant above.
OFFICEPILOT_LOCAL_USER_ID=officepilot-local-demo
OFFICEPILOT_LOCAL_TENANT_ID=local-demo

# Google mode requires a distinct OAuth token file per authenticated user.
# Authorize with: .venv/bin/python test_google_apis.py --user-id officepilot-local-demo
# Example: {"officepilot-local-demo":"~/.officepilot/tokens/officepilot-local-demo.json"}
OFFICEPILOT_WORKSPACE_MODE=mock
OFFICEPILOT_WORKSPACE_TOKEN_FILES={"officepilot-local-demo":"~/.officepilot/tokens/officepilot-local-demo.json"}

# Document ingestion requires an explicit tenant. Existing rows without a tenant
# remain unscoped and are not returned by tenant-filtered retrieval.
OFFICEPILOT_INGEST_TENANT_ID=

# Leave all external task writes disabled unless explicitly authorized.
OFFICEPILOT_ALLOW_GOOGLE_TASK_WRITES=false

# ADK and CrewAI share this provider switch. Ollama remains the default.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
CREWAI_OLLAMA_MODEL=llama3.1:latest

# Select Groq explicitly; there is no automatic provider fallback.
# Use openai/gpt-oss-20b if that model is the available option for your account.
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b